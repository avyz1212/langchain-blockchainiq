# Dedicated wallet holding a little USDC on Base. Settlement is gasless
# for the payer. NEVER a main wallet — this key signs payments.
AGENT_PRIVATE_KEY=

# Per-call spend cap in USD. A 402 asking more than this is refused
# before anything is signed. Default 0.60.
BIQ_MAX_PRICE_PER_CALL=0.60

# Set to 1 to probe prices and verify payments locally without paying.
BIQ_DRY_RUN=
